# ==============================================================================
# Reprova Frontend Authentication & Configuration Environment Variables
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.local.example .env.local
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# MongoDB Connection String (Atlas Cluster or Local Instance)
# Local instance default: mongodb://localhost:27017/reprova
# Atlas Cluster example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/reprova?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/reprova

# NextAuth Canonical Application URL
# Development: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret for JWT Encryption & Session Signing
# Generate a secure 32-character key using: openssl rand -base64 32
NEXTAUTH_SECRET=your-secure-random-nextauth-secret-min-32-chars

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# FastAPI Backend Service URL
NEXT_PUBLIC_API_URL=http://localhost:8000
